  nodes:
  - speakerName: Ricardo
    dialogueText: "Cosme, \xBFc\xF3mo arrancamos hoy?"
    sfx: {fileID: 0}
    backgroundImage: {fileID: 0}
    isWaitingForProductNode: 0
  - speakerName: Don Cosme
    dialogueText: Bien, Ricky. Vos?  Ayer la vi a Laurita, pero no tu pibe. Se ve
      que los amigos le avisaron que no llegaron las figus.
    sfx: {fileID: 0}
    backgroundImage: {fileID: 0}
    isWaitingForProductNode: 0
  - speakerName: Ricardo
    dialogueText: "Igual mire que yo tambi\xE9n las quiero esas, eh jaja. Deme unos
      chicles, unas galletitas (paquete de snacks) y una lata de picadillo. Aprovechando
      que hoy tengo franco me voy a la bicicleter\xEDa de Tom\xE1s a ver si me parcha
      la cubierta de la moto, asi cuando me termina el laburo picamos algo con el
      mate."
    sfx: {fileID: 0}
    backgroundImage: {fileID: 0}
    isWaitingForProductNode: 0
  - speakerName: 
    dialogueText: 
    sfx: {fileID: 0}
    backgroundImage: {fileID: 0}
    isWaitingForProductNode: 1
  - speakerName: Don Cosme
    dialogueText: "Ac\xE1 ten\xE9s"
    sfx: {fileID: 0}
    backgroundImage: {fileID: 0}
    isWaitingForProductNode: 0
  - speakerName: Ricardo
    dialogueText: "Nos vemos, Don Cosme! \u2018tama\xF1ana!"
    sfx: {fileID: 0}
