  m_Name: Marcela_Day2
  m_EditorClassIdentifier: 
  nodes:
  - speakerName: Marcela
    dialogueText: "\xBFC\xF3mo est\xE1s, divino?\r\n"
    sfx: {fileID: 8300000, guid: 096c54729980f6f47bd44103c1384d96, type: 3}
    blockAdvanceUntilSfxEnd: 0
    backgroundImage: {fileID: 0}
    isWaitingForProductNode: 0
    productsToDeliver: 
  - speakerName: Don Cosme
    dialogueText: "Que sea viudo no significa que est\xE9 disponible, Marcelita\u2026\r\n"
    sfx: {fileID: 0}
    blockAdvanceUntilSfxEnd: 0
    backgroundImage: {fileID: 0}
    isWaitingForProductNode: 0
    productsToDeliver: 
  - speakerName: Marcela
    dialogueText: "Sos dif\xEDcil, eh! Dame un atado de puchos, Y tres cervezas que
      a la noche vienen mis sobrinos y chupan como esponja nueva.\r\n"
    sfx: {fileID: 0}
    blockAdvanceUntilSfxEnd: 0
    backgroundImage: {fileID: 0}
    isWaitingForProductNode: 0
    productsToDeliver: 
  - speakerName: 
    dialogueText: 
    sfx: {fileID: 0}
    blockAdvanceUntilSfxEnd: 0
    backgroundImage: {fileID: 0}
    isWaitingForProductNode: 1
    productsToDeliver: 160000000a0000000a0000000a000000
  - speakerName: Don Cosme
    dialogueText: "Ponete contenta, que al menos vienen a visitarte. Micaela no s\xE9
      cuando vendr\xE1 a Buenos Aires, a ver si trae a la nena y la veo de nuevo,
      que ya debe estar enorme.\r\n"
    sfx: {fileID: 8300000, guid: 5ff4b1ffa9c238d48926b8770c51100e, type: 3}
    blockAdvanceUntilSfxEnd: 0
    backgroundImage: {fileID: 0}
    isWaitingForProductNode: 0
    productsToDeliver: 
  - speakerName: Marcela
    dialogueText: "\xBFCu\xE1ndo era que se fue a Espa\xF1a? \xBFEn el 99, no? Ahora
      que estamos m\xE1s acomodados, por ah\xED viene y se queda.\r\n"
    sfx: {fileID: 0}
    blockAdvanceUntilSfxEnd: 0
    backgroundImage: {fileID: 0}
    isWaitingForProductNode: 0
    productsToDeliver: 
  - speakerName: Don Cosme
    dialogueText: "Y, pasaron siete a\xF1os. Me dijo que por ah\xED el a\xF1o que
      viene, antes de que la nena siga avanzando grados, as\xED se acostumbra a hacer
      todo ac\xE1. Me pidi\xF3 si la acompa\xF1aba a ver unos departamentos por el
      barrio, as\xED que en una de esas\u2026\r\n"
    sfx: {fileID: 0}
    blockAdvanceUntilSfxEnd: 0
    backgroundImage: {fileID: 0}
    isWaitingForProductNode: 0
    productsToDeliver: 
  - speakerName: Marcela
    dialogueText: "Ojal\xE1, a ver si as\xED sonre\xEDs un poco m\xE1s. Hasta ma\xF1ana.\r\n"
    sfx: {fileID: 0}
    blockAdvanceUntilSfxEnd: 0
    backgroundImage: {fileID: 0}
    isWaitingForProductNode: 0
    productsToDeliver: 
