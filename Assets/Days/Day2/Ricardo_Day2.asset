  nodes:
  - speakerName: Ricardo
    dialogueText: "Cosme, \xBFc\xF3mo arrancamos hoy?\r\n"
    sfx: {fileID: 0}
    blockAdvanceUntilSfxEnd: 0
    backgroundImage: {fileID: 0}
    isWaitingForProductNode: 0
    productsToDeliver: 
  - speakerName: Don Cosme
    dialogueText: "Bien, Ricky. \xBFVos? Ayer la vi a Laurita, pero no a tu pibe.
      Se ve que los amigos le avisaron que no llegaron las figus.\r\n"
    sfx: {fileID: 0}
    blockAdvanceUntilSfxEnd: 0
    backgroundImage: {fileID: 0}
    isWaitingForProductNode: 0
    productsToDeliver: 
  - speakerName: Ricardo
    dialogueText: "Igual mire que yo tambi\xE9n las quiero esas, eh. \xA1Me guarda
      a mi unos paquetes antes que a los pibes! jaja. Deme unos chicles, unas galletitas,
      unas papitas, y una lata de picadillo. Aprovechando que hoy tengo franco me
      voy a la bicicleter\xEDa de Tom\xE1s a ver si me emparcha la cubierta de la
      moto, y llevo algo para picar con unos mates cuando me termine el laburo. Nunca
      le cobra a los chicos cuando inflan la bici o hacen alg\xFAn arreglo medio
      pavo, as\xED que prefiero no caer con las manos vac\xEDas.\r\n"
    sfx: {fileID: 0}
    blockAdvanceUntilSfxEnd: 0
    backgroundImage: {fileID: 0}
    isWaitingForProductNode: 0
    productsToDeliver: 
  - speakerName: 
    dialogueText: 
    sfx: {fileID: 0}
    blockAdvanceUntilSfxEnd: 0
    backgroundImage: {fileID: 0}
    isWaitingForProductNode: 1
    productsToDeliver: 03000000040000000c00000012000000
  - speakerName: Don Cosme
    dialogueText: "Ac\xE1 ten\xE9s"
    sfx: {fileID: 0}
    blockAdvanceUntilSfxEnd: 0
    backgroundImage: {fileID: 0}
    isWaitingForProductNode: 0
    productsToDeliver: 
