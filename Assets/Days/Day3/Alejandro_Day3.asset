  nodes:
  - speakerName: Alejandro
    dialogueText: "\xBFC\xF3mo andamos, Cosme?\r\n"
    sfx: {fileID: 8300000, guid: 5ff4b1ffa9c238d48926b8770c51100e, type: 3}
    blockAdvanceUntilSfxEnd: 0
    backgroundImage: {fileID: 0}
    isWaitingForProductNode: 0
    productsToDeliver: 
  - speakerName: Don Cosme
    dialogueText: "Querido, todo bien. \xBFQu\xE9 llev\xE1s?\r\n"
    sfx: {fileID: 0}
    blockAdvanceUntilSfxEnd: 0
    backgroundImage: {fileID: 0}
    isWaitingForProductNode: 0
    productsToDeliver: 
  - speakerName: Alejandro
    dialogueText: '3 gaseosas grandes.

'
    sfx: {fileID: 0}
    blockAdvanceUntilSfxEnd: 0
    backgroundImage: {fileID: 0}
    isWaitingForProductNode: 0
    productsToDeliver: 
  - speakerName: 
    dialogueText: 
    sfx: {fileID: 0}
    blockAdvanceUntilSfxEnd: 0
    backgroundImage: {fileID: 0}
    isWaitingForProductNode: 1
    productsToDeliver: 080000000800000008000000
  - speakerName: Don Cosme
    dialogueText: "Dejame adivinar: \xBFNoche de jueguitos con los pibes?\r\n"
    sfx: {fileID: 0}
    blockAdvanceUntilSfxEnd: 0
    backgroundImage: {fileID: 0}
    isWaitingForProductNode: 0
    productsToDeliver: 
  - speakerName: Don Cosme
    dialogueText: "Viste c\xF3mo son estos vagos, cada vez que les pido que traigan
      ellos, \u201Cse olvidan\u201D. Y sumame un vinito.\r\n"
    sfx: {fileID: 0}
    blockAdvanceUntilSfxEnd: 0
    backgroundImage: {fileID: 0}
    isWaitingForProductNode: 0
    productsToDeliver: 
  - speakerName: 
    dialogueText: 
    sfx: {fileID: 0}
    blockAdvanceUntilSfxEnd: 0
    backgroundImage: {fileID: 0}
    isWaitingForProductNode: 1
    productsToDeliver: 0b000000
  - speakerName: Don Cosme
    dialogueText: 'Todo tuyo. Nos vemos!

'
    sfx: {fileID: 8300000, guid: 669f96bf24cdb07459eb9ecaa4165d20, type: 3}
    blockAdvanceUntilSfxEnd: 0
    backgroundImage: {fileID: 0}
    isWaitingForProductNode: 0
    productsToDeliver: 
  - speakerName: Voz de muchacho a lo lejos
    dialogueText: "\xA1No te olvides velitas, Ale!\r\n"
    sfx: {fileID: 0}
    blockAdvanceUntilSfxEnd: 0
    backgroundImage: {fileID: 0}
    isWaitingForProductNode: 0
    productsToDeliver: 
  - speakerName: Alejandro
    dialogueText: "Cierto, sumemos unas velitas. Que, ehhh\u2026. Mat\xEDas trae
      al primo, cumpli\xF3 a\xF1os el martes.\r\n"
    sfx: {fileID: 0}
    blockAdvanceUntilSfxEnd: 0
    backgroundImage: {fileID: 0}
    isWaitingForProductNode: 0
    productsToDeliver: 
  - speakerName: Don Cosme
    dialogueText: No me quedaron. Preguntale a Natalia, que fue el cumple del pibe
      hace poco. Por ahi tiene una para que zafen
    sfx: {fileID: 0}
    blockAdvanceUntilSfxEnd: 0
    backgroundImage: {fileID: 0}
    isWaitingForProductNode: 0
    productsToDeliver: 
  - speakerName: Don Cosme
    dialogueText: "P\xE1senla lindo y saludo al primo del Mati. Es el hijo del H\xE9ctor,
      \xBFno? Nos vemos.\r\n"
    sfx: {fileID: 8300000, guid: 5b75d106c84cfa34688b42144fc750fa, type: 3}
    blockAdvanceUntilSfxEnd: 0
    backgroundImage: {fileID: 0}
    isWaitingForProductNode: 0
    productsToDeliver: 
  - speakerName: Alejandro
    dialogueText: "Si, si. Eh\u2026 El mismo. Nos vemos.\r\n"
    sfx: {fileID: 0}
    blockAdvanceUntilSfxEnd: 0
    backgroundImage: {fileID: 0}
    isWaitingForProductNode: 0
    productsToDeliver: 
  - speakerName: Don Cosme
    dialogueText: "Bueno, ya est\xE1. Me gan\xE9 mi descanso, se termin\xF3 el s\xE1bado."
    sfx: {fileID: 8300000, guid: 41d48ef1a7ff5e248b675eba5f82d0d0, type: 3}
    blockAdvanceUntilSfxEnd: 0
    backgroundImage: {fileID: 0}
    isWaitingForProductNode: 0
    productsToDeliver: 
