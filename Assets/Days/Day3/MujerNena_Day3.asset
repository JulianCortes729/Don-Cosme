    dialogueText: 
    sfx: {fileID: 0}
    blockAdvanceUntilSfxEnd: 0
    backgroundImage: {fileID: 0}
    isWaitingForProductNode: 1
    productsToDeliver: 0e0000000f0000000600000006000000
  - speakerName: Don Cosme
    dialogueText: "\xBFvas a amasar a esta hora?\r\n"
    sfx: {fileID: 8300000, guid: 077af5048526169418cd36fdca2db188, type: 3}
    blockAdvanceUntilSfxEnd: 0
    backgroundImage: {fileID: 0}
    isWaitingForProductNode: 0
    productsToDeliver: 
  - speakerName: Natalia
    dialogueText: "Eh\u2026 No, no. Nada que ver. Es que me qued\xE9 sin nada. Deme
      tambi\xE9n un at\xFAn. Y una lata de duraznos y, eh\u2026 Unos caramelos.\r\n"
    sfx: {fileID: 0}
    blockAdvanceUntilSfxEnd: 0
    backgroundImage: {fileID: 0}
    isWaitingForProductNode: 0
    productsToDeliver: 
  - speakerName: 
    dialogueText: 
    sfx: {fileID: 0}
    blockAdvanceUntilSfxEnd: 0
    backgroundImage: {fileID: 0}
    isWaitingForProductNode: 1
    productsToDeliver: 11000000140000000200000002000000
  - speakerName: Don Cosme
    dialogueText: "\xA1Listo! Que tengan buen fin de semana.\r\n"
    sfx: {fileID: 0}
    blockAdvanceUntilSfxEnd: 0
    backgroundImage: {fileID: 0}
    isWaitingForProductNode: 0
    productsToDeliver: 
  - speakerName: Magali
    dialogueText: "Mami, mami, y si\u2026\r\n"
    sfx: {fileID: 0}
    blockAdvanceUntilSfxEnd: 0
    backgroundImage: {fileID: 0}
    isWaitingForProductNode: 0
    productsToDeliver: 
  - speakerName: Natalia
    dialogueText: "Shhh, vamos, Magui. \xA1no molestes a Don Cosme! Nos vemos, que
      tenga lindo d\xEDa!\r\n"
    sfx: {fileID: 0}
    blockAdvanceUntilSfxEnd: 0
    backgroundImage: {fileID: 0}
    isWaitingForProductNode: 0
    productsToDeliver: 
