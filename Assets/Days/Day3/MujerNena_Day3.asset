    isWaitingForProductNode: 0
    productsToDeliver: 
  - speakerName: Don Cosme
    dialogueText: "\xA1Buen d\xEDa, lindas! \xBFQu\xE9 van a llevar hoy tan temprano?\r\n"
    sfx: {fileID: 0}
    blockAdvanceUntilSfxEnd: 0
    backgroundImage: {fileID: 0}
    isWaitingForProductNode: 0
    productsToDeliver: 
  - speakerName: Natalia
    dialogueText: 'Deme una harina, un aceite, dos chocolates grandes

'
